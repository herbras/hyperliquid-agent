# scalper-sniper — copy ke .env dan isi

ANTHROPIC_API_KEY=sk-ant-...

HL_REPO=/Users/ibrahimnh/Documents/panduan-openclaw/hyperliquid

# Default exchange untuk fetch on-demand
EXCHANGE=binanceusdm

# Untuk Hyperliquid native data (alternative)
# COINS=BTC,ETH,SOL,HYPE

# Optional: signing key untuk eksekusi nyata via Hyperliquid SDK
# HATI-HATI: gunakan agent-wallet (sub-account), bukan main wallet
# HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_PRIVATE_KEY=    # JANGAN commit, JANGAN main wallet

# Telegram alert untuk konfirmasi entry yang valid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=MarkdownV2

TERMINAL_CWD=~/.hermes/profiles/scalper-sniper/workspace
