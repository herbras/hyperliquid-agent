# scalper-sniper — copy ke .env dan isi

ANTHROPIC_API_KEY=sk-ant-...

HL_REPO=/Users/ibrahimnh/Documents/panduan-openclaw/hyperliquid

# === Default exchange untuk fetch on-demand ===
# Sniper biasanya inherit dari scout (pair yang sama), tapi bisa override.
EXCHANGE=binanceusdm

# === Untuk Hyperliquid native data (alternative) ===
# COINS=BTC,ETH,SOL,HYPE

# === Untuk Bybit V5 native data (alternative) ===
# SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# CATEGORY=linear

# === Trade execution keys (UNTUK FUTURE — saat ini sniper cuma kasih level) ===
# JANGAN commit ke git. Pakai sub-account dengan limited balance.

# Hyperliquid (signing key untuk eksekusi via SDK):
# HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_PRIVATE_KEY=    # agent wallet only, BUKAN main wallet

# Bybit V5 (HMAC API key):
# Buat di Bybit → API Management → Create New Key
# Permission: Read + Trade ONLY (NEVER enable Withdraw)
# Bind IP biar key permanent (no 3-bulan expiry).
# Recommended: dedicated sub-account dengan limited balance.
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BYBIT_ENV=mainnet           # atau testnet untuk dry-run
# Atau pakai RSA (advanced):
# BYBIT_API_PRIVATE_KEY_PATH=/absolute/path/to/private.pem

# === Telegram alert untuk konfirmasi entry valid ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=MarkdownV2

TERMINAL_CWD=~/.hermes/profiles/scalper-sniper/workspace
