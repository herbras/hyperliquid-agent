# scalper-scout — copy ke .env dan isi

# === Wajib ===
ANTHROPIC_API_KEY=sk-ant-...

# === Path ke repo skill (dipakai cron) ===
HL_REPO=/Users/ibrahimnh/Documents/panduan-openclaw/hyperliquid

# === Market data — pilih SATU dari dua mode ===
# Mode A: ccxt generic (Binance USDM perp)
# Pair preference: BTC/ETH/SOL untuk US window, ditambah pair Asia untuk Asia window.
EXCHANGE=binanceusdm
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,BNB/USDT:USDT
TF=1h    # bias frame per STRATEGI-15M.md (bukan 15m lagi)

# Mode B: Hyperliquid native — uncomment kalau pakai cron/market-scan-hyperliquid.yaml
# COINS=BTC,ETH,SOL,HYPE,XRP
# TF=1h

# === Telegram alert (opsional tapi recommended) ===
# Buat bot via @BotFather di Telegram, dapat token, lalu /start ke bot
# untuk dapatkan chat_id (atau pakai @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=MarkdownV2
TELEGRAM_DISABLE_PREVIEW=1

# === Working dir untuk cron output ===
TERMINAL_CWD=~/.hermes/profiles/scalper-scout/workspace
